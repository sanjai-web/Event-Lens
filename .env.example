# EventLens Environment Configuration

ENVIRONMENT=development
DEBUG=true

# Database: Supports PostgreSQL (with pgvector) OR MySQL 8.0+
# For MySQL: DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/eventlens
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/eventlens
DATABASE_URL=mysql+aiomysql://root:1234@localhost:3306/eventlens

# Security
SECRET_KEY=change-this-to-a-secure-random-64-character-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudflare R2 Object Storage (Zero Egress)
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your_r2_access_key>
R2_SECRET_ACCESS_KEY=<your_r2_secret_key>
R2_BUCKET_NAME=eventlens-media
R2_PUBLIC_URL=https://media.eventlens.in

# Razorpay Per-Event Billing (Use Test Mode keys for development)
RAZORPAY_KEY_ID=rzp_test_TXuZaB5bBrGHnI
RAZORPAY_KEY_SECRET=o7pOCHUChsYSh9Xxd9CM7srf
RAZORPAY_WEBHOOK_SECRET=sample_razorpay_webhook_secret_123

# WhatsApp Business Cloud API
WHATSAPP_API_TOKEN=<your_meta_system_user_token>
WHATSAPP_PHONE_NUMBER_ID=<your_meta_phone_number_id>
WHATSAPP_VERIFY_TOKEN=eventlens_verify_token
